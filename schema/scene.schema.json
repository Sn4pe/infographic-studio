{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Sn4pe/infographic-studio/scene.schema.json",
  "title": "Infographic Studio scene v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "title", "description", "width", "height", "panels"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "subtitle": { "type": "string" },
    "eyebrow": { "type": "string" },
    "footer": { "type": "string" },
    "width": { "type": "integer", "minimum": 400, "maximum": 4096 },
    "height": { "type": "integer", "minimum": 300, "maximum": 4096 },
    "theme": { "enum": ["blueprint", "paper", "midnight"] },
    "palette": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "background": { "$ref": "#/definitions/color" }, "panel": { "$ref": "#/definitions/color" },
        "ink": { "$ref": "#/definitions/color" }, "muted": { "$ref": "#/definitions/color" },
        "line": { "$ref": "#/definitions/color" }, "accent": { "$ref": "#/definitions/color" },
        "secondary": { "$ref": "#/definitions/color" }, "warm": { "$ref": "#/definitions/color" }
      }
    },
    "sources": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false, "required": ["title", "url"],
        "properties": { "title": { "type": "string" }, "url": { "type": "string", "pattern": "^https://" } }
      }
    },
    "assets": {
      "type": "object", "propertyNames": { "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$" },
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["description"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "prompt": { "type": "string" }, "provenance": { "type": "string" },
          "license": { "type": "string" }
        }
      }
    },
    "panels": {
      "type": "array", "minItems": 1, "maxItems": 24,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "x", "y", "width", "height", "elements"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "x": { "type": "number", "minimum": 0 }, "y": { "type": "number", "minimum": 0 },
          "width": { "type": "number", "minimum": 100 }, "height": { "type": "number", "minimum": 100 },
          "title": { "type": "string" }, "kicker": { "type": "string" },
          "framed": { "type": "boolean" },
          "grid": { "type": "boolean" },
          "elements": { "type": "array", "maxItems": 2000, "items": { "$ref": "#/definitions/element" } }
        }
      }
    }
  },
  "definitions": {
    "id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$" },
    "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "paint": { "type": "string", "pattern": "^(#[0-9a-fA-F]{6}|none|\\$(background|panel|ink|muted|line|accent|secondary|warm))$" },
    "point": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
    "artworkBounds": {
      "type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number" }, "y": { "type": "number" },
        "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "element": {
      "type": "object", "additionalProperties": false, "required": ["id", "type"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "container": { "$ref": "#/definitions/id" },
        "type": { "enum": ["rect", "ellipse", "path", "polygon", "line", "arrow", "wave", "text", "image", "callout", "icon"] },
        "icon": { "type": "string", "pattern": "^tabler/[a-z0-9-]+$" },
        "artworkId": { "$ref": "#/definitions/id" },
        "artworkBounds": { "$ref": "#/definitions/artworkBounds" },
        "geometryRole": { "enum": ["connector", "illustration"] },
        "x": { "type": "number" }, "y": { "type": "number" },
        "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 },
        "rx": { "type": "number", "minimum": 0 }, "ry": { "type": "number", "minimum": 0 },
        "x2": { "type": "number" }, "y2": { "type": "number" },
        "points": { "type": "array", "minItems": 3, "items": { "$ref": "#/definitions/point" } },
        "d": { "type": "string", "minLength": 1, "pattern": "^[MmLlHhVvCcSsQqTtAaZz0-9eE., +\\-\\s]+$" },
        "fill": { "$ref": "#/definitions/paint" }, "stroke": { "$ref": "#/definitions/paint" },
        "strokeWidth": { "type": "number", "minimum": 0, "maximum": 100 },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "dash": { "type": "array", "minItems": 1, "items": { "type": "number", "minimum": 0 } },
        "rotation": { "type": "number" },
        "amplitude": { "type": "number", "minimum": 0 },
        "cycles": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "phase": { "type": "number" }, "chirp": { "type": "number", "minimum": 0, "maximum": 20 },
        "envelope": { "enum": ["constant", "grow", "pulse"] },
        "text": { "type": "string", "minLength": 1 },
        "fontSize": { "type": "number", "minimum": 8, "maximum": 150 },
        "weight": { "enum": ["regular", "semibold"] },
        "align": { "enum": ["left", "center", "right"] },
        "asset": { "$ref": "#/definitions/id" },
        "fit": { "enum": ["contain", "cover"] },
        "side": { "enum": ["auto", "left", "right", "top", "bottom"] },
        "target": {
          "oneOf": [
            { "$ref": "#/definitions/point" },
            {
              "type": "object", "additionalProperties": false, "required": ["element"],
              "properties": {
                "element": { "$ref": "#/definitions/id" },
                "at": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "minimum": 0, "maximum": 1 } }
              }
            }
          ]
        }
      },
      "allOf": [
        { "if": { "required": ["geometryRole"] }, "then": { "properties": { "type": { "enum": ["line", "path"] } } } },
        { "if": { "properties": { "type": { "enum": ["rect", "image", "icon"] } } }, "then": { "required": ["x", "y", "width", "height"] } },
        { "if": { "properties": { "type": { "const": "icon" } } }, "then": { "required": ["icon"] } },
        { "if": { "properties": { "type": { "const": "ellipse" } } }, "then": { "required": ["x", "y", "rx", "ry"] } },
        { "if": { "properties": { "type": { "enum": ["line", "arrow"] } } }, "then": { "required": ["x", "y", "x2", "y2"] } },
        { "if": { "properties": { "type": { "const": "polygon" } } }, "then": { "required": ["points"] } },
        { "if": { "properties": { "type": { "const": "path" } } }, "then": { "required": ["d"] } },
        { "if": { "properties": { "type": { "const": "text" } } }, "then": { "required": ["x", "y", "width", "text"] } },
        { "if": { "properties": { "type": { "const": "callout" } } }, "then": { "required": ["x", "y", "width", "text", "target"] } },
        { "if": { "properties": { "type": { "const": "wave" } } }, "then": { "required": ["x", "y", "width", "amplitude", "cycles"] } },
        { "if": { "properties": { "type": { "const": "image" } } }, "then": { "required": ["asset"] } }
      ]
    }
  }
}
