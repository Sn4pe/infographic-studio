{
  "name": "@sn4pe/infographic-studio",
  "version": "0.1.0-alpha.3",
  "description": "An agent-friendly composition engine for illustrated technical figures.",
  "type": "module",
  "bin": {
    "infographic-studio": "./cli/cli.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./schema": "./schema/scene.schema.json",
    "./document-schema": "./schema/document.schema.json"
  },
  "files": [
    "cli",
    "src",
    "schema",
    "assets",
    "skills",
    "examples",
    ".codex-plugin",
    ".claude-plugin",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "examples": "node scripts/build-examples.js",
    "check": "node cli/cli.js check examples/windshield-frit/scene.json --strict",
    "verify:package": "node scripts/verify-package.js"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "author": "Sn4pe",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sn4pe/infographic-studio.git"
  },
  "keywords": [
    "infographic",
    "scientific-illustration",
    "svg",
    "agent-skills",
    "pdf"
  ],
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "ajv": "^8.17.1",
    "fontkit": "^2.0.4",
    "pdfkit": "^0.17.2",
    "svg-to-pdfkit": "^0.1.8"
  },
  "devDependencies": {
    "pdfjs-dist": "^6.3.289"
  }
}
